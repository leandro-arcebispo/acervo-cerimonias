# Produção (Turso). Em dev, sem estas vars, usa arquivo local em ./data/acervo.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Auth (senha única compartilhada). Sem BASIC_AUTH_PASSWORD, o app libera acesso
# (bom pra dev). Defina antes de expor o app na internet.
BASIC_AUTH_USER=grupo
BASIC_AUTH_PASSWORD=
